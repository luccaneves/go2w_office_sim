<?xml version='1.0' ?>

<launch>
  <arg name="use_sim_time" default="false"/>
  <arg name="failover_mode" default="false"/>
  <arg name="gazebo_version" default='8'/>
  <arg name="use_rviz" default='true'/>
  <arg name="spawn_x" default='-4.0'/>
  <arg name="spawn_y" default='-6.0'/>
  <arg name="spawn_z" default='0.45'/>
  <arg name="spawn_yaw" default='0.0'/>
  <arg name="namespace" default='robot1'/>



  <include file="$(find-pkg-share go2w_rmf_office_nav)/launch/bringup_go2w_nav.launch.py">
    <arg name="use_sim_time" value="$(var use_sim_time)"/>
    <arg name="use_rviz" value="$(var use_rviz)"/>
    <arg name="spawn_x" value="$(var spawn_x)"/>
    <arg name="spawn_y" value="$(var spawn_y)"/>
    <arg name="spawn_z" value="$(var spawn_z)"/>
    <arg name="spawn_yaw" value="$(var spawn_yaw)"/>
  </include>


